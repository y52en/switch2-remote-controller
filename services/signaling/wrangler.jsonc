{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "switch2-remote-signal",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-31",
  "assets": { "directory": "../../apps/host/public", "binding": "ASSETS" },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "ControlRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ControlRoom"] }]
}
