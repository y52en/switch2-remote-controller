# Based on ESP-IDF 5.5.3 defaults from ESP32-BLE5-NSController-Emulator.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_EXT_ADV=y
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=30
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=150
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_SIZE=128
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=30
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_SIZE=512
CONFIG_BT_NIMBLE_HCI_EVT_BUF_SIZE=255
CONFIG_HID_REPORT_INTERVAL=10
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
